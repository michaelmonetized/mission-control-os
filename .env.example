# Clerk (ADR-0010/0015) — `clerk link` + `clerk env pull`
# Vite needs the VITE_ prefix; server/API can use CLERK_*
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex — `cd apps/web && bunx convex dev` writes these
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
CONVEX_URL=
VITE_CONVEX_SITE_URL=
CONVEX_DEPLOY_KEY=

# Resend (ADR-0036) — also set on Convex: `bunx convex env set RESEND_API_KEY re_...`
RESEND_API_KEY=

# Control plane URL for Agent / Desktop
MC_CONTROL_PLANE=http://127.0.0.1:5173
MC_WEB_URL=http://127.0.0.1:5173
