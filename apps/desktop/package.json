{
  "name": "@mc/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.mjs",
  "scripts": {
    "dev": "electron .",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "typecheck": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "effect": "^3.22.1"
  },
  "build": {
    "appId": "com.missioncontrol.os.desktop",
    "productName": "Mission Control",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main.mjs",
      "preload.mjs",
      "effect-runtime.mjs",
      "effect-program.mjs"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
