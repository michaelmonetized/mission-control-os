<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mission Control Local Agent — user LaunchAgent (ADR-0013)
  Install: apps/agent/install/install.sh
  Logs: ~/Library/Logs/MissionControl/agent.stdout.log
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.missioncontrol.agent</string>
    <key>ProgramArguments</key>
    <array>
      <string>__MC_AGENT_BIN__</string>
      <string>daemon</string>
      <string>--control-plane</string>
      <string>__MC_CONTROL_PLANE__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>__MC_AGENT_DATA__</string>
    <key>StandardOutPath</key>
    <string>__MC_AGENT_DATA__/agent.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__MC_AGENT_DATA__/agent.stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>MC_CONTROL_PLANE</key>
      <string>__MC_CONTROL_PLANE__</string>
      <key>RUST_LOG</key>
      <string>info</string>
    </dict>
  </dict>
</plist>
