{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "installCommand": "bun install",
  "buildCommand": "bun run build && node scripts/vercel-promote-boa.mjs",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "master": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ]
}
